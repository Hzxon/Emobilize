<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Emobilize" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/shadcn_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/shadcn_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/shadcn_background</item>
    </style>

    <style name="Theme.Emobilize.SplashLight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/shadcn_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/shadcn_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/shadcn_background</item>
    </style>

    <style name="Theme.Emobilize.SplashDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/shadcn_background_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/shadcn_background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/shadcn_background_dark</item>
    </style>
</resources>
