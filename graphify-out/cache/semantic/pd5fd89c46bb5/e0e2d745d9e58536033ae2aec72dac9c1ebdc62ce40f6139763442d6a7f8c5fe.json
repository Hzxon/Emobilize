{"nodes": [{"id": "context_emobilize", "label": "Emobilize", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Android Kotlin and Jetpack Compose task-and-calendar app, package ayodong.emobilize, single Gradle module :app, minSdk 28, compileSdk and targetSdk 37. Branch tasks-radial-menu, remote https://github.com/Hzxon/Emobilize. It is not React, Tailwind, or Figma Make; the user-level AGENTS.md belongs to a different web project and should be ignored."}, {"id": "context_design_md", "label": "DESIGN.md", "file_type": "document", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read with CONTEXT.md before editing UI. Display-token values are explained here; do not invent a new palette."}, {"id": "context_ui_only_change", "label": "UI-only change rule", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Change appearance only. Do not change save behavior, filters, or architecture, and do not build the task list or calendar blocks from a Composable. UI sources live under app/src/main/java/ayodong/emobilize/ui/; colors, type, and sizes live in ui/theme/ and DESIGN.md. After edits, run .\\gradlew.bat :app:compileDebugKotlin --offline."}, {"id": "context_layered_architecture", "label": "Layered architecture", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI goes to ViewModel, then use case, then a repository interface, then data. The domain layer does not import Compose. TasksViewModel is the only ViewModel and re-reads the repository after a write."}, {"id": "context_manual_wiring", "label": "Manual composition root", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MainActivity creates AppContainer, then viewModel(factory = TasksViewModelFactory(container)). There is no Hilt. Do not add a dependency-injection library."}, {"id": "context_tasksviewmodelfactory", "label": "TasksViewModelFactory", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Factory passed the AppContainer so MainActivity can construct TasksViewModel without a DI framework."}, {"id": "context_legacy_model_package", "label": "Legacy model package", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "model/TaskModels.kt and model/CalendarModels.kt are old duplicates and are not imported. Live models are in domain/model/. Do not edit the legacy files."}, {"id": "context_taskdraft", "label": "TaskDraft", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lives in TasksViewModel.kt because its fields are mutableStateOf. Do not move TaskDraft into domain."}, {"id": "context_composable_state", "label": "Composable state boundary", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Composables may own only themeId, the active tab, and menuOpen. Task and block persistence stays out of Composables; data state lives in TasksViewModel. Card color and spacing changes should not open the ViewModel."}, {"id": "context_in_memory_data", "label": "In-memory data", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Task and calendar data live in memory and disappear when the process dies. Sample content is in data/repository/SampleData.kt."}, {"id": "context_tasksviewmodel", "label": "TasksViewModel", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only ViewModel. Owns task data state and TaskDraft, re-reads the repository after writes, and deletes a selected calendar block through deleteSelectedBlock()."}, {"id": "context_mainactivity", "label": "MainActivity", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_appcontainer", "label": "AppContainer", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_emobilizeapp", "label": "EmobilizeApp", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arranges every screen and decides when a form appears. File ui/EmobilizeApp.kt."}, {"id": "context_settingsscreen", "label": "SettingsScreen", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App preferences and categories. The gear icon in the header opens Settings. Theme is changed only from Settings."}, {"id": "context_tasksscreen", "label": "TasksScreen", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Task list, filters, and task cards. File ui/tasks/TasksScreen.kt. Composables TasksScreen and TaskCard."}, {"id": "context_taskcard", "label": "TaskCard", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows a category stripe, a priority badge, and a date only when those fields exist."}, {"id": "context_addtaskcard", "label": "AddTaskCard", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add card on the Tasks tab only. The calendar tab uses CalendarFormSheet instead, and editing an existing task uses TaskFormSheet, not this card."}, {"id": "context_taskformsheet", "label": "TaskFormSheet", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full edit sheet for an existing task, with DateField and TimeField. It is not AddTaskCard."}, {"id": "context_calendarformsheet", "label": "CalendarFormSheet", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add and edit form on the Calendar tab. Add offers only Event and Regular Schedule; Task is absent. When editing an existing item, the type is locked to that item's kind."}, {"id": "context_calendarscreen", "label": "CalendarScreen", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calendar header and Month, Week, and Day bodies, plus the card list. File ui/calendar/CalendarScreen.kt. Composables CalendarScreen, DayAgenda, and AgendaRow."}, {"id": "context_dayagenda", "label": "DayAgenda", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_agendarow", "label": "AgendaRow", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_bottomdock", "label": "BottomDock", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bottom dock with the Tasks and Calendar tabs, the center button face, and the theme orb. File ui/dock/RadialDock.kt. Composables BottomDock, FabFace, and ThemeOrb."}, {"id": "context_fabface", "label": "FabFace", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "context_themeorb", "label": "ThemeOrb", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named as a dock composable next to the center button. Theme changes are also specified to happen only from Settings, so the orb's role as a control versus a status mark is not settled in this guide."}, {"id": "context_radialmenu", "label": "RadialMenu", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fan of Add, Update, Edit, and Delete opened by the center button. Update is hidden on the Calendar tab. Open and close use a spring with dampingRatio 0.75 and Spring.StiffnessMediumLow: the fan grows from the hub, buttons rise from the dock, and the icon rotates 90 degrees. Do not replace these actions with a navigation menu."}, {"id": "context_task", "label": "Task", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "domain/model/Task.kt. category and priority may be null. An empty deadline means no date. range is the time range. eventType is Event, Task, or Regular Schedule. time and eventEndTime look like 10:30 AM; range clock fields look like 09:00."}, {"id": "context_timeblock", "label": "TimeBlock", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "id, title, start, end as decimal hours, and category. Stored per LocalDate. A calendar block is shown as Regular Schedule with category and start-to-end time."}, {"id": "context_localpalette", "label": "LocalPalette", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screen colors come from LocalPalette.current in ui/theme/Palette.kt. Only two themes exist: NeutralLight (id 1) and NeutralDark (id 2). Do not add another palette."}, {"id": "context_neutrallight", "label": "NeutralLight", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Light palette, theme id 1."}, {"id": "context_neutraldark", "label": "NeutralDark", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark palette, theme id 2."}, {"id": "context_appmetrics", "label": "AppMetrics", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spacing and card sizes in ui/theme/Metrics.kt. cardRadius, cardMinHeight, pageHorizontal 18.dp, and headerHorizontal 24.dp."}, {"id": "context_appfont", "label": "AppFont", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Text uses appStyle(...) and AppFont in ui/theme/Type.kt. The font is Montserrat, shipped under res/font/."}, {"id": "context_shadcn_scheme", "label": "Shadcn scheme", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "palette.scheme from ui/theme/Shadcn.kt supplies background, popover, border, and card."}, {"id": "context_sampledata", "label": "SampleData", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initial in-memory sample tasks and schedule in data/repository/SampleData.kt."}, {"id": "context_eventtype", "label": "EventType", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Event, Task, or Regular Schedule. Calendar task rows show this kind along with category and optional priority."}, {"id": "context_task_filters", "label": "Task filters", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All, Today, Tomorrow, and Later. A task with no schedule appears only in All."}, {"id": "context_calendar_agenda", "label": "Calendar agenda", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Month, Week, and Day put a vertical card list under the date picker, not an hour grid. Items sort by start time; items with no time go below. An empty day reads Nothing scheduled."}, {"id": "context_add_task_behavior", "label": "Add task behavior", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The title is focused and the keyboard opens. Optional icons are Category, Priority, and Schedule (Deadline or Time range). Tapping the active choice clears it. Add task saves only when the title is filled. Close, an outside tap, or back discards. An invalid time range opens the Schedule panel and does not save."}, {"id": "context_english_strings", "label": "Frozen English UI strings", "file_type": "rationale", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing English UI copy stays as written, including Title, Close, Tasks, Calendar, and Nothing scheduled."}, {"id": "context_compile_check", "label": "Offline Kotlin compile", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verification command is .\\gradlew.bat :app:compileDebugKotlin --offline. adb is not on PATH, so a successful compile does not mean the UI was tried on a device."}, {"id": "context_menucolor", "label": "menuColor", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Radial action colors: Add green, Update blue, Edit actionEdit, Delete danger."}, {"id": "context_deleteselectedblock", "label": "deleteSelectedBlock", "file_type": "concept", "source_file": "CONTEXT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Edit and Delete select a card. Removing a calendar block goes through TasksViewModel.deleteSelectedBlock()."}], "edges": [{"source": "context_emobilize", "target": "context_design_md", "relation": "references", "confidence": "EXTRACTED", "conf