{"nodes": [{"id": "github_workflows_ci_ci", "label": "CI", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs on every push and every pull request. One workflow holds a verification job and a separate dependency-graph submission job."}, {"id": "github_workflows_ci_cancel_in_progress", "label": "Cancel in-progress CI", "file_type": "rationale", "source_file": ".github/workflows/ci.yml", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The concurrency group is the workflow name plus the git ref. cancel-in-progress is true so a newer push or pull request replaces a stale run of this workflow on that ref."}, {"id": "github_workflows_ci_check", "label": "check", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Job name is Build, test, and resolve dependencies. It runs on ubuntu-latest with a 30 minute timeout and contents read permission. Gradle calls use --stacktrace. The job does not submit a dependency graph."}, {"id": "github_workflows_ci_dependency_graph", "label": "dependency-graph", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Submits the Gradle dependency graph only when the event is a push and the ref is refs/heads/main, so pull requests do not submit. It needs contents write. Test and lint configurations are excluded, and the configuration cache is turned off for the submission."}, {"id": "github_workflows_ci_resolvecidependencies", "label": ":app:resolveCiDependencies", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First Gradle step of the check job. It resolves the app module dependencies before tests and APK assembly."}, {"id": "github_workflows_ci_testdebugunittest", "label": ":app:testDebugUnitTest", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Debug unit-test task for the app module. It runs after dependency resolution and before the debug APK is assembled."}, {"id": "github_workflows_ci_assembledebug", "label": ":app:assembleDebug", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds the debug APK as the last step of the check job, after unit tests."}, {"id": "github_workflows_ci_jdk25", "label": "JDK 25 Temurin", "file_type": "concept", "source_file": ".github/workflows/ci.yml", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both jobs set up Temurin JDK 25 with actions/setup-java@v5 before any Gradle step."}, {"id": "github_workflows_ci_android_sdk", "label": "Android SDK", "file_type": "concept", "source_file": ".github/workflows/ci.yml", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both jobs install the Android SDK with android-actions/setup-android@v4. The check job also sets up Gradle with gradle/actions/setup-gradle@v6; the dependency-graph job does not."}, {"id": "github_workflows_ci_dependency_submission", "label": "Gradle dependency submission", "file_type": "code", "source_file": ".github/workflows/ci.yml", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses gradle/actions/dependency-submission@v6 with additional-arguments --no-configuration-cache and dependency-graph-exclude-configurations matching test or lint. This action replaces the setup-gradle step used by the check job."}], "edges": [{"source": "github_workflows_ci_ci", "target": "github_workflows_ci_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L12", "weight": 1.0}, {"source": "github_workflows_ci_ci", "target": "github_workflows_ci_dependency_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L43", "weight": 1.0}, {"source": "github_workflows_ci_ci", "target": "github_workflows_ci_cancel_in_progress", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L6", "weight": 1.0}, {"source": "github_workflows_ci_check", "target": "github_workflows_ci_resolvecidependencies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L35", "weight": 1.0}, {"source": "github_workflows_ci_check", "target": "github_workflows_ci_testdebugunittest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L38", "weight": 1.0}, {"source": "github_workflows_ci_check", "target": "github_workflows_ci_assembledebug", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L41", "weight": 1.0}, {"source": "github_workflows_ci_check", "target": "github_workflows_ci_jdk25", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/ci.yml", "source_location": "L22", "weight": 1.0}, {"source": "github_workflows_ci_check", "target": "github_workflows_ci_android_sdk", "rel